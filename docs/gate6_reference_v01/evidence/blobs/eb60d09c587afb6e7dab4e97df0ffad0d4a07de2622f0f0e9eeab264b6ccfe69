        need(report['source']==context['source_projection'],'reported_source_projection')
        root_record(proofs['requester_review'],'ActivePlanetRoot',requester['artifact']['artifact_id'],
            dict(request_sha256=sha(case['request']),offer_sha256=sha(body),result_sha256=sha(semantic)),body['source_record_ref'])
        need(observed['venue_work']==observed['requester_work']==1,'observed_native_calls')
