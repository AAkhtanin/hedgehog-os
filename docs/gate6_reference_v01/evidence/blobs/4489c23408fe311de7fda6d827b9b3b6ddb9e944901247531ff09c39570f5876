"""Additional irreversible worker restrictions layered over Docker default seccomp."""
import ctypes
import errno
import resource

DENY = ("clone", "clone3", "fork", "vfork", "execve", "execveat", "ptrace",
        "process_vm_readv", "process_vm_writev", "pidfd_getfd", "kill", "tkill", "tgkill")

def restrict_worker():
    resource.setrlimit(resource.RLIMIT_CPU, (30, 35))
    resource.setrlimit(resource.RLIMIT_FSIZE, (16 * 1024**2, 16 * 1024**2))
    resource.setrlimit(resource.RLIMIT_NOFILE, (64, 64))
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(38, 1, 0, 0, 0) != 0:
        raise OSError(ctypes.get_errno(), "no_new_privileges")
    lib = ctypes.CDLL("libseccomp.so.2", use_errno=True)
    lib.seccomp_init.argtypes = [ctypes.c_uint32]
    lib.seccomp_init.restype = ctypes.c_void_p
    lib.seccomp_syscall_resolve_name.argtypes = [ctypes.c_char_p]
    lib.seccomp_syscall_resolve_name.restype = ctypes.c_int
    lib.seccomp_rule_add.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int, ctypes.c_uint]
    lib.seccomp_load.argtypes = [ctypes.c_void_p]
    lib.seccomp_release.argtypes = [ctypes.c_void_p]
    ctx = lib.seccomp_init(0x7fff0000)
    if not ctx:
        raise RuntimeError("seccomp_init")
    rules = []
    try:
        for name in DENY:
            number = lib.seccomp_syscall_resolve_name(name.encode())
            if number == -1:
                raise RuntimeError("unknown_syscall:" + name)
            # libseccomp translates architecture-specific pseudo syscall numbers.
            if lib.seccomp_rule_add(ctx, 0x00050000 | errno.EPERM, number, 0) != 0:
                raise RuntimeError("seccomp_rule:" + name)
            rules.append(name)
        if lib.seccomp_load(ctx) != 0:
            raise RuntimeError("seccomp_load")
    finally:
        lib.seccomp_release(ctx)
    return rules
