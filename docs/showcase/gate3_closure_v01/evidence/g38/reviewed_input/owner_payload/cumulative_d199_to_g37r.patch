+        "advice_created_at": advice_created_at,
+        "advice_valid_from": valid_from,
+        "advice_valid_to": valid_to,
+        "advice_ttl_seconds": value["time_envelope"]["ttl_seconds"],
+        "regret_status": "KNOWN" if regret["state"] == "KNOWN" else "UNKNOWN",
