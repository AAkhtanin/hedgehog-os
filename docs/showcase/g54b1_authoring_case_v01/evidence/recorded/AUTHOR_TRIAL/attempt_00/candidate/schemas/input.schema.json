{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:football:peer-input:v01",
  "description": "Normalized input. Incomplete budget/timezone/duration inputs receive CLARIFY at runtime; mandatory control identities must remain present to bind finite peer closure.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "role",
        "events",
        "policy"
      ],
      "properties": {
        "version": {
          "const": "g54.peer_input.v01"
        },
        "role": {
          "const": "publisher"
        },
        "events": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_id",
                  "request",
                  "inventory"
                ],
                "properties": {
                  "event_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$"
                  },
                  "request": {
                    "$ref": "#/$defs/request"
                  },
                  "inventory": {
                    "$ref": "#/$defs/inventory"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_id",
                  "request",
                  "inventory",
                  "semantic_proposal",
                  "semantic_capture"
                ],
                "properties": {
                  "event_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$"
                  },
                  "request": {
                    "$ref": "#/$defs/request"
                  },
                  "inventory": {
                    "$ref": "#/$defs/inventory"
                  },
                  "semantic_proposal": {
                    "$ref": "#/$defs/proposal"
                  },
                  "semantic_capture": {
                    "$ref": "#/$defs/capture"
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 8
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "role",
        "events",
        "policy"
      ],
      "properties": {
        "version": {
          "const": "g54.peer_input.v01"
        },
        "role": {
          "const": "requester"
        },
        "events": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_id",
                  "request"
                ],
                "properties": {
                  "event_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$"
                  },
                  "request": {
                    "$ref": "#/$defs/request"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_id",
                  "request",
                  "semantic_proposal",
                  "semantic_capture"
                ],
                "properties": {
                  "event_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$"
                  },
                  "request": {
                    "$ref": "#/$defs/request"
                  },
                  "semantic_proposal": {
                    "$ref": "#/$defs/proposal"
                  },
                  "semantic_capture": {
                    "$ref": "#/$defs/capture"
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 8
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      }
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "revision",
        "operation",
        "team_ref",
        "venue_ref",
        "timezone",
        "currency",
        "budget_minor",
        "owner_approval_ref",
        "sessions"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "FIND_OFFER",
            "CONFIRM_MOCK_BOOKING",
            "VERIFY_EXISTING",
            "CLARIFY"
          ]
        },
        "team_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "venue_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "timezone": {
          "const": "Europe/Tirane"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "budget_minor": {
          "type": "integer",
          "minimum": 0
        },
        "owner_approval_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "start",
              "end",
              "allow_shift_minutes"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
              },
              "start": {
                "type": "string",
                "pattern": "^2027-01-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
              },
              "end": {
                "type": "string",
                "pattern": "^2027-01-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
              },
              "allow_shift_minutes": {
                "enum": [
                  0,
                  30
                ]
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "venue_ref",
        "currency",
        "fields"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "venue_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field_id",
              "surface",
              "full_size",
              "price_minor",
              "available_utc",
              "occupied_utc"
            ],
            "properties": {
              "field_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
              },
              "surface": {
                "enum": [
                  "NATURAL_GRASS",
                  "ARTIFICIAL",
                  "OTHER"
                ]
              },
              "full_size": {
                "type": "boolean"
              },
              "price_minor": {
                "type": "integer",
                "minimum": 0
              },
              "available_utc": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 0,
                "maxItems": 32
              },
              "occupied_utc": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 0,
                "maxItems": 32
              }
            }
          },
          "minItems": 1,
          "maxItems": 4
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_root",
        "peer_root",
        "venue_ref",
        "accept_offers",
        "publish_enabled",
        "release_enabled",
        "audience",
        "release_uses",
        "max_source_age",
        "ttl_seconds",
        "status",
        "approvals",
        "booking_enabled"
      ],
      "properties": {
        "local_root": {
          "enum": [
            "VenueRoot",
            "ActivePlanetRoot"
          ]
        },
        "peer_root": {
          "enum": [
            "VenueRoot",
            "ActivePlanetRoot"
          ]
        },
        "venue_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "accept_offers": {
          "type": "boolean"
        },
        "publish_enabled": {
          "type": "boolean"
        },
        "release_enabled": {
          "type": "boolean"
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
          },
          "minItems": 0,
          "maxItems": 1,
          "uniqueItems": true
        },
        "release_uses": {
          "type": "array",
          "items": {
            "const": "LOCAL_CONTEXT"
          },
          "minItems": 0,
          "maxItems": 1,
          "uniqueItems": true
        },
        "max_source_age": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED",
            "SUPERSEDED",
            "UNAVAILABLE"
          ]
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approval_ref",
              "scope",
              "request_sha256"
            ],
            "properties": {
              "approval_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
              },
              "scope": {
                "enum": [
                  "SHIFT",
                  "BOOK"
                ]
              },
              "request_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "booking_enabled": {
          "type": "boolean"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "parameters"
      ],
      "properties": {
        "mode": {
          "enum": [
            "FIND_OFFER",
            "CONFIRM_MOCK_BOOKING",
            "VERIFY_EXISTING",
            "CLARIFY"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "revision",
            "team_ref",
            "venue_ref",
            "timezone",
            "currency",
            "budget_minor",
            "owner_approval_ref",
            "sessions"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "team_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
            },
            "venue_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
            },
            "timezone": {
              "const": "Europe/Tirane"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "budget_minor": {
              "type": "integer",
              "minimum": 0
            },
            "owner_approval_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "session_id",
                  "start",
                  "end",
                  "allow_shift_minutes"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
                  },
                  "start": {
                    "type": "string",
                    "pattern": "^2027-01-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^2027-01-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
                  },
                  "allow_shift_minutes": {
                    "enum": [
                      0,
                      30
                    ]
                  }
                }
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "origin",
        "capture_ref",
        "captured_at",
        "request_sha256",
        "proposal_sha256",
        "original_request",
        "original_response",
        "provider",
        "model"
      ],
      "properties": {
        "version": {
          "const": "football.semantic_capture.v01"
        },
        "origin": {
          "enum": [
            "CONTROLLED",
            "LOCALLY_SUPPLIED_LIVE"
          ]
        },
        "capture_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "captured_at": {
          "type": "integer",
          "minimum": 0
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "original_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request"
          ],
          "properties": {
            "request": {
              "$ref": "#/$defs/request"
            }
          }
        },
        "original_response": {
          "$ref": "#/$defs/proposal"
        },
        "provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        }
      }
    }
  }
}
