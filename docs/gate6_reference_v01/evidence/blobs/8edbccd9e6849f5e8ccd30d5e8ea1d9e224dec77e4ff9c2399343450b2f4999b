], "time_envelope_id": "dependency_time_envelope_v01:4ae931640f4f5cfc7fa006c349fcdf2affde7b07ce8efea024b677abb1c78d17"}]}, "dependency_set_candidate_fingerprint": "e6c4e12dc012ba825ff0b7aac9ad3b9a607472a4ebe5a320611ba2cc5bde605b", "evaluation_context_id": "context:u1:canonical", "evaluation_time": 1010, "evaluation_time_source": "u1.controlled_utc", "execution_binding": {"capability_definition_ref": "capability_definition:60e7b3da8e130aeb61d26bd4932ad8ddd4179e301a40307fde6c4b091620320d", "capability_implementation_ref": "capability_implementation:7cea5dc1503654aaf78452324dead8aa3526206b018b8665372289143ff05225", "capability_input_contract_ref": "capability_input_contract:0284739a24fa6762b95dcf95ea33344a599802829a9b8cd24b04472a38cf0a98", "capability_output_contract_ref": "capability_output_contract:6dedab5d639041243eece0b5f68c2f62b08c2ebdead2ebb4c92ffb374016c05b"}, "execution_source": {"admission_id": "capability_admission:a85c3a2c5bbdb60e7d5cf464724bf3789a5d2514a1e8b822498decfba5637744", "catalogue_revision": 0, "code_sources": [{"public_symbol": "candidate_domain.effect.execute_booking", "source_sha256": "f06c394747f8746dae844e787c760f07c782e9eb1dad918a6864aa2fa7803be7", "source_utf8": "\"\"\"One source-owned atomic disposable booking snapshot through native MOCK dispatch.\"\"\"\nfrom hedgehog.external_drs import gate5_contracts_v01 as c, gate5_native_v01 as n, gate5_exchange_v01 as x\nfrom hedgehog import action_commit_packet_v02 as action, work_execution_host_v01 as hosts\nfrom hedgehog.kernel import effect_firewall_v01 as firewall, abi_v01 as abi\nfrom demo import run_action_packet_portability_v01 as donor\nfrom candidate_domain.domain import need, Refusal, inventory_check, available, overlap, logical_object, planning_equal\nfrom candidate_domain.policy import approve_booking\nfrom candidate_domain.storage import read, save, state, object_path\nfrom candidate_domain.native import review\n\n# Per owning process, bound only by local reviewed dispatch code. Never s