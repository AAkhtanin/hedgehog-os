{
  "spec": {
    "name": "hedgehog_os.machine_manifest",
    "version": "0.25.0",
    "status": "draft_for_mvp_demo",
    "language": "ru",
    "created_for": "Hedgehog OS / Fractal Reflexive OS proof-of-architecture demo",
    "scope": "single-node local demo with mock domain, local JSON DRS, deterministic stubs allowed"
  },

  "project": {
    "project_id": "proj_hedgehog_os_demo",
    "title": "Hedgehog OS / Fractal Reflexive OS Demo",
    "codename": "hedgehog_os_demo",
    "description": "Proof-of-architecture runtime demonstrating Root orchestration, WorldState, Local DRS, CandidateVector generation, AVF scoring, AttractorPacket, Architect planning, Executor result proposals, Post V&V, GT validation, Root-only final output, DRS writeback, Marennya and UP hooks.",
    "not_goal": [
      "not a full operating system",
      "not a real government service integration",
      "not a real external DRS network",
      "not a chatbot-only demo",
      "not a UI-first project"
    ],
    "demo_domain": {
      "domain_id": "domain_mock_government_certificate",
      "title": "Mock government certificate request",
      "description": "A simulated bureaucratic task used to demonstrate branching, forbidden vectors, dead-ends, DRS reuse, GT-TTL, Marennya reflections, and UP protocol templates."
    }
  },

  "architecture_level": {
    "v0_2": "ontology: entities, roles, invariants, DRS layers, Time, GT hooks",
    "v0_25": "algorithmic execution layer: how modules compute and interact",
    "v0_3_future": "modes, fractal limits, needle taxonomy, advanced policies"
  },

  "core_principles": [
    {
      "id": "principle_root_cognitive_authority",
      "statement": "RootOrchestrator is the cognitive authority of the local system and the only entity allowed to produce FinalOutput."
    },
    {
      "id": "principle_execution_substrate",
      "statement": "Code substrate enforces schemas, time, DRS IO, budgets, hooks, persistence, and invariants. It does not replace Root cognition."
    },
    {
      "id": "principle_vassal_boundary",
      "statement": "A vassal's vassal is not Root's vassal. Parent clusters set boundary conditions and evaluate returned snapshots, but do not micromanage nested internal trajectories."
    },
    {
      "id": "principle_memory_first",
      "statement": "Before generating a plan, the system must attempt local memory / DRS retrieval with TemporalQuery."
    },
    {
      "id": "principle_time_as_axis",
      "statement": "Time is a mandatory axis of truth, retrieval, decay, and validity. Every DRSRecord requires TimeEnvelope."
    },
    {
      "id": "principle_epistemic_layers",
      "statement": "Work, Thoughts, UP, Quarantine, and DeadEnds are separate epistemic layers and must not be silently merged."
    },
    {
      "id": "principle_structural_not_prose",
      "statement": "Internal exchange is structured JSON objects. Prose is output rendering, not the primary internal substrate."
    },
    {
      "id": "principle_avf_before_architect",
      "statement": "AVF builds a viability field and AttractorPacket before Architect receives the task."
    },
    {
      "id": "principle_gt_after_post_vv",
      "statement": "GTValidator runs after Post V&V and before Root FinalOutput."
    },
    {
      "id": "principle_quarantine_first",
      "statement": "Marennya and UP artifacts are written to Quarantine before promotion."
    }
  ],

  "actors": {
    "human_owner": {
      "id": "actor_human_owner",
      "name": "Human Owner",
      "role": "ultimate_authority",
      "responsibilities": [
        "sets policies and preferences",
        "approves autonomy boundaries",
        "can override or configure modes",
        "owns local memory and private DRS data"
      ]
    },
    "root_orchestrator": {
      "id": "actor_root_orchestrator",
      "name": "RootOrchestrator",
      "role": "cognitive_control_plane",
      "engine_policy": {
        "mvp_engine": "deterministic_python_allowed",
        "future_engine": "LLM_or_SLM",
        "note": "Root may be implemented as deterministic class in MVP, but architecture assumes future LLM/SLM cognitive authority."
      },
      "responsibilities": [
        "receive User/Event",
        "normalize Intent",
        "assemble WorldState",
        "run DRS retrieval",
        "run CandidateVectorGenerator",
        "run AVF scoring",
        "create AttractorPacket",
        "call Architect",
        "dispatch Executors",
        "collect ResultProposals",
        "run Post V&V",
        "run GTValidator",
        "create FinalOutput",
        "write DRS records",
        "trigger Marennya and UP hooks"
      ],
      "hard_limits": [
        "must not let Executor produce FinalOutput",
        "must not bypass TimeEnvelope",
        "must not bypass DRS layer separation",
        "must not allow forbidden vectors to reach Architect"
      ]
    }
  },

  "roles": {
    "architect": {
      "id": "role_architect",
      "input_contract": "attractor_packet",
      "output_contract": "plan_graph",
      "responsibilities": [
        "convert AttractorPacket into executable PlanGraph",
        "respect forbidden regions",
        "respect branch budgets",
        "declare time_assumptions",
        "declare branching mode",
        "assign executor nodes",
        "avoid final answer to user"
      ],
      "forbidden": [
        "final_output",
        "expanding hard-forbidden regions",
        "using unavailable capabilities",
        "ignoring Time assumptions"
      ]
    },
    "executor": {
      "id": "role_executor",
      "input_contract": "plan_node",
      "output_contract": "result_proposal",
      "responsibilities": [
        "execute or simulate assigned PlanGraph node",
        "return ResultProposal only",
        "include evidence, cost, risks, TimeEnvelope and trace_refs"
      ],
      "forbidden": [
        "final_output",
        "mutating Work directly without Root writeback",
        "inventing evidence"
      ]
    },
    "post_vv": {
      "id": "role_post_vv",
      "input_contract": "result_proposal",
      "output_contract": "vv_report",
      "responsibilities": [
        "validate schema",
        "validate evidence",
        "validate time",
        "validate policy",
        "validate forbidden region compliance",
        "normalize features for GT"
      ]
    },
    "gt_validator": {
      "id": "role_gt_validator",
      "input_contract": "vv_reports",
      "output_contract": "gt_report",
      "responsibilities": [
        "compute payoff",
        "select winner or mix",
        "update Elo or no_update",
        "compute regret",
        "compute half_life_hours and decay_rate",
        "emit decision accept/revise/reject/rerun"
      ],
      "note": "GT does not prove truth. It selects robust strategy under payoff specification."
    },
    "marenna": {
      "id": "role_marenna",
      "input_contract": "work_gt_feedback_bundle",
      "output_contract": "marenna_record",
      "responsibilities": [
        "generate intradomain reflections",
        "create patches, dead_end_candidates, validator_patch candidates",
        "write first to Quarantine",
        "promote only after validation"
      ]
    },
    "up": {
      "id": "role_up",
      "input_contract": "work_thoughts_up_bundle",
      "output_contract": "up_record",
      "responsibilities": [
        "generate transfer opportunities",
        "generate protocol templates",
        "generate links between domains",
        "write first to UP Quarantine",
        "promote only after validation"
      ]
    }
  },

  "entities": {
    "intent": {
      "id_prefix": "intent_",
      "description": "Canonicalized user/event request."
    },
    "world_state": {
      "id_prefix": "ws_",
      "description": "Root-assembled state of the world before Architect: time, user context, session context, DRS summaries, active policy and relevant memory pointers."
    },
    "temporal_query": {
      "id_prefix": "tq_",
      "description": "Mandatory retrieval time filter with as_of, time_range and freshness_bias."
    },
    "time_envelope": {
      "id_prefix": "te_",
      "description": "Mandatory time vector for DRS records: PT, KT, ET, CT and TTL."
    },
    "candidate_vector": {
      "id_prefix": "cv_",
      "description": "Pre-plan direction of possible solution. Generated by needles, DRS records, external pointers, or fallback templates."
    },
    "attractor_packet": {
      "id_prefix": "ap_",
      "description": "AVF output passed to Architect: viable vectors, forbidden regions, budgets, time assumptions and instructions."
    },
    "plan_graph": {
      "id_prefix": "plan_",
      "description": "Architect output: DAG/chain/tree/mixed plan with node dependencies and executor assignments."
    },
    "result_proposal": {
      "id_prefix": "rp_",
      "description": "Executor output candidate. Not a final answer."
    },
    "vv_report": {
      "id_prefix": "vv_",
      "description": "Post V&V normalized validation report."
    },
    "gt_report": {
      "id_prefix": "gt_",
      "description": "GTValidator output: winner/mix, payoff, ratings, regret, half-life, decision."
    },
    "final_output": {
      "id_prefix": "fo_",
      "description": "User-facing output created only by RootOrchestrator."
    },
    "drs_record": {
      "id_prefix": "drs_",
      "description": "Local DRS registry record with layer, pointer/summary/content stub, TimeEnvelope, provenance, access metadata, and optional GT metadata."
    },
    "needle": {
      "id_prefix": "needle_",
      "description": "Configurable module declaring capabilities, vectors, contracts, policies and metadata."
    },
    "viability_feedback": {
      "id_prefix": "vf_",
      "description": "Feedback from actual outcomes to future AVF scoring."
    }
  },

  "time_model": {
    "required": true,
    "time_axes": {
      "PT": {
        "name": "Physical Time",
        "description": "System/clock time when record was created or observed."
      },
      "KT": {
        "name": "Knowledge Time",
        "description": "As-of time: when knowledge is considered valid or known."
      },
      "ET": {
        "name": "Event Time",
        "description": "Time when domain event happened, if applicable."
      },
      "CT": {
        "name": "Context Time",
        "description": "Session/task contextual time anchor."
      }
    },
    "time_envelope_minimum_fields": [
      "pt_created_at",
      "kt_asof",
      "et_observed_at",
      "ct_session_anchor",
      "ttl_seconds"
    ],
    "temporal_query_minimum_fields": [
      "as_of",
      "time_range",
      "freshness_bias"
    ],
    "invariants": [
      "Every DRSRecord must include TimeEnvelope.",
      "Every retrieval must include TemporalQuery.",
      "Architect output must include time_assumptions."
    ]
  },

  "execution_router": {
    "required": true,
    "purpose": "Select the cheapest safe execution mode instead of forcing every request through the full cognitive pipeline.",
    "full_pipeline_is_maximum_loop_not_default": true,
    "mvp_demo_mode": "proof_full_pipeline",
    "shortcut_execution_enabled_in_v0_25": false,
    "shortcut_disabled_for_demo": true,
    "direct_reuse_candidate_only_in_v0_25": true,
    "adaptive_routing_future_runtime": true,
    "reason": "The v0.25 demo intentionally exercises the full pipeline to prove contracts and invariants.",
    "levels": [
      {
        "level": "L0",
        "id": "deterministic_reflex",
        "description": "Ready needle, known safe deterministic action, no Architect, no heavy LLM.",
        "examples": [
          "switch TV input",
          "open known device view",
          "repeat safe local UI action"
        ],
        "required_controls": [
          "policy_check",
          "permission_check_if_actionful",
          "minimal_trace_audit",
          "drs_writeback_when_state_changes_or_action_performed"
        ]
      },
      {
        "level": "L1",
        "id": "direct_reuse",
        "description": "Fresh trusted DRS record or protocol replay through explicit Root shortcut logic.",
        "required_gates": [
          "ReuseScore",
          "Freshness",
          "GTTrust",
          "PolicyOK",
          "ConflictCheck",
          "TimeEnvelope_validity",
          "ActionPermission_if_external_action"
        ],
        "skip_allowed_only_if": "Explicit RootFinalFromReuse or direct protocol shortcut exists and tests prove Architect and Executor were skipped legally."
      },
      {
        "level": "L2",
        "id": "memory_informed_execution",
        "description": "Prior records found, but shortcut not allowed. Full or partial pipeline may run with constrained context.",
        "note": "retrieved_records > 0 means memory_context_applied, not direct_reuse."
      },
      {
        "level": "L3",
        "id": "avf_architect_execution",
        "description": "AVF selects CandidateVectors and creates AttractorPacket; Architect creates PlanGraph for tasks needing planning without full deep branching."
      },
      {
        "level": "L4",
        "id": "full_fractal_reasoning",
        "description": "Multiple branches, Executors, Post V&V, GT selection, and full DRS writeback for novel, ambiguous, high-risk, high-value, or multi-path tasks."
      },
      {
        "level": "L5",
        "id": "deferred_reflection",
        "description": "Marennya, UP, deep research, idle validation, scheduled or deferred work outside the immediate response critical path unless explicitly requested."
      }
    ],
    "routing_inputs": [
      "intent_complexity",
      "risk_level",
      "novelty",
      "presence_of_installed_needle",
      "presence_of_drs_candidate",
      "ReuseScore",
      "Freshness",
      "GTTrust",
      "PolicyOK",
      "ConflictCheck",
      "ActionPermission",
      "user_confirmation_requirement",
      "latency_token_budget",
      "need_for_provenance",
      "whether_state_changes_or_external_action_will_occur"
    ],
    "invariants": [
      "Full pipeline must be available but not mandatory.",
      "No DRS retrieval without TemporalQuery in any execution mode.",
      "L0 and L1 paths must not bypass safety, policy, permission, audit, or required DRS writeback.",
      "A DRS hit is not direct reuse by itself.",
      "retrieved_records > 0 only permits memory_context_applied by default.",
      "Direct reuse requires explicit Root shortcut logic.",
      "Direct reuse must not be implemented by accident.",
      "Tests for direct reuse must prove Architect and Executor were skipped.",
      "Direct external or action execution must respect policy, access control, audit, and DRS writeback.",
      "L5 deferred reflection must not block immediate user response unless explicitly requested."
    ]
  },

  "drs": {
    "mode": "local_json_for_mvp",
    "model": "pointer_first_registry_resolver_index",
    "mvp_inline_content_allowed": true,
    "mvp_inline_content_limits": "small, local, non-secret, mock/demo only",
    "pointer_first_preferred": true,
    "payload_storage_kinds": [
      "inline",
      "local_json",
      "local_secure_vault",
      "local_memory",
      "vector_store",
      "document_store",
      "project_store",
      "external_drs_pointer"
    ],
    "sensitive_payload_forbidden_in_drs_content": [
      "credential",
      "credentials",
      "api_key",
      "apikey",
      "token",
      "password",
      "secret",
      "private_key",
      "passport_number",
      "card_number",
      "cvv"
    ],
    "pointer_records_require": [
      "storage_kind",
      "ref"
    ],
    "pointer_access_policy_fields": [
      "visibility",
      "requires_user_confirmation",
      "read_summary_only",
      "read_payload_allowed",
      "write_allowed",
      "allowed_use",
      "forbidden_use"
    ],
    "resolver_note": "Pointer resolution is not implemented in MVP LocalDRS. LocalDRS validates pointer shape and stores pointer metadata only.",
    "external_drs": {
      "enabled_in_mvp": false,
      "mock_allowed": true,
      "future_mode": "pointer_based_resolve_request_consent_transfer_ack"
    },
    "storage_layout": {
      "root": "data/drs/",
      "layers": {
        "work": "data/drs/work/",
        "thoughts": "data/drs/thoughts/",
        "up": "data/drs/up/",
        "quarantine": "data/drs/quarantine/",
        "deadends": "data/drs/deadends/"
      }
    },
    "layers": {
      "work": {
        "id": "layer_work",
        "description": "Canonical task outcomes, accepted facts, final decisions, successful and failed execution results.",
        "direct_mutation_by": ["root_orchestrator"],
        "forbidden_mutation_by": ["marenna", "up", "executor"]
      },
      "thoughts": {
        "id": "layer_thoughts",
        "description": "Validated Marennya reflections, patches, lessons and intradomain improvements.",
        "direct_mutation_by": ["root_orchestrator_after_validation"]
      },
      "up": {
        "id": "layer_up",
        "description": "Validated UP opportunities, protocol templates and cross-domain links.",
        "direct_mutation_by": ["root_orchestrator_after_validation"]
      },
      "quarantine": {
        "id": "layer_quarantine",
        "description": "Raw Marennya and UP drafts before validation and promotion."
      },
      "deadends": {
        "id": "layer_deadends",
        "description": "Negative experience, forbidden/failed paths, invalidated approaches and conditions."
      }
    },
    "record_requirements": [
      "record_id",
      "layer",
      "type",
      "domain",
      "content",
      "time_envelope",
      "provenance",
      "status"
    ],
    "optional_record_blocks": [
      "gt",
      "viability_feedback",
      "validation",
      "signature",
      "hash"
    ]
  },

  "pipeline": {
    "id": "pipeline_core_v0_25",
    "steps": [
      {
        "order": 1,
        "id": "step_user_event",
        "name": "User/Event Input",
        "input": "raw_user_text_or_event",
        "output": "raw_event"
      },
      {
        "order": 2,
        "id": "step_intent_normalization",
        "name": "Intent Normalization",
        "owner": "root_orchestrator",
        "input": "raw_event",
        "output": "intent"
      },
      {
        "order": 3,
        "id": "step_world_state",
        "name": "WorldState Assembly",
        "owner": "root_orchestrator",
        "input": "intent",
        "output": "world_state",
        "must_use": ["temporal_query", "local_drs"]
      },
      {
        "order": 4,
        "id": "step_candidate_vectors",
        "name": "CandidateVector Generation",
        "owner": "root_orchestrator",
        "input": "world_state",
        "output": "candidate_vectors",
        "allowed_sources": [
          "installed_needles",
          "local_drs",
          "external_drs_pointers",
          "fallback_exploration_templates"
        ],
        "forbidden": [
          "free_llm_generation_of_vectors"
        ]
      },
      {
        "order": 5,
        "id": "step_avf",
        "name": "AVF Scoring",
        "owner": "root_orchestrator",
        "input": "candidate_vectors",
        "output": "attractor_packet",
        "method": "deterministic_vectorized_scoring"
      },
      {
        "order": 6,
        "id": "step_architect",
        "name": "Architect Planning",
        "owner": "architect",
        "input": "attractor_packet",
        "output": "plan_graph"
      },
      {
        "order": 7,
        "id": "step_executors",
        "name": "Executor Proposals",
        "owner": "executor",
        "input": "plan_graph",
        "output": "result_proposals"
      },
      {
        "order": 8,
        "id": "step_post_vv",
        "name": "Post V&V",
        "owner": "post_vv",
        "input": "result_proposals",
        "output": "vv_reports"
      },
      {
        "order": 9,
        "id": "step_gt",
        "name": "GT Validation",
        "owner": "gt_validator",
        "input": "vv_reports",
        "output": "gt_report"
      },
      {
        "order": 10,
        "id": "step_root_final",
        "name": "Root Final Synthesis",
        "owner": "root_orchestrator",
        "input": ["result_proposals", "vv_reports", "gt_report"],
        "output": "final_output"
      },
      {
        "order": 11,
        "id": "step_drs_writeback",
        "name": "DRS Writeback",
        "owner": "root_orchestrator",
        "input": ["final_output", "gt_report", "trace"],
        "output": "drs_records"
      },
      {
        "order": 12,
        "id": "step_marenna_up_hooks",
        "name": "Marennya and UP Hooks",
        "owner": "root_orchestrator",
        "input": ["drs_records", "gt_report", "viability_feedback"],
        "output": ["marenna_record_optional", "up_record_optional"]
      }
    ]
  },

  "avf": {
    "id": "module_avf",
    "name": "Attractor Viability Field",
    "description": "Pre-fractal Root layer that scores candidate solution directions before Architect planning.",
    "position": "after_world_state_and_candidate_vectors_before_architect",
    "does": [
      "applies HardMask",
      "applies SoftMask",
      "computes vectorized viability scores",
      "selects Top-K candidate vectors",
      "allocates branch budgets",
      "creates AttractorPacket"
    ],
    "does_not": [
      "does not generate plans",
      "does not freely invent vectors",
      "does not replace Architect",
      "does not create final answer"
    ],
    "candidate_vector_sources": [
      "installed_needles",
      "local_drs",
      "external_drs_pointers",
      "fallback_exploration_templates"
    ],
    "feature_vector_order": [
      "rel",
      "p_success",
      "utility",
      "cost",
      "risk",
      "time_penalty",
      "policy_conflict",
      "gt_prior",
      "novelty"
    ],
    "mode_weight_vector_default": {
      "alpha_rel": 1.0,
      "beta_p_success": 1.0,
      "chi_utility": 1.0,
      "delta_cost": 0.6,
      "epsilon_risk": 1.0,
      "zeta_time_penalty": 0.4,
      "eta_policy_conflict": 2.0,
      "lambda_gt_prior": 0.8,
      "rho_novelty": 0.2
    },
    "formula": {
      "feature_vector": "x_i = [rel_i, p_i, utility_i, cost_i, risk_i, time_i, conflict_i, gt_i, novelty_i]",
      "weight_vector": "w = [alpha, beta, chi, -delta, -epsilon, -zeta, -eta, lambda, rho]",
      "score": "S = Xw",
      "final_viability": "FV(v_i) = HardMask(v_i) * SoftMask(v_i) * S(v_i)"
    },
    "cold_start_policy": {
      "history_confidence": "low",
      "fallback_to_architect_creativity": true,
      "exploration_mode": "controlled",
      "requires_feedback_writeback": true,
      "rho_novelty_boost": true
    },
    "output": "attractor_packet"
  },

  "gt": {
    "id": "module_gt_validator",
    "name": "GTValidator",
    "position": "after_post_vv_before_root_final_output",
    "modes": [
      "result_selection",
      "marenna_game",
      "up_game",
      "memory_evo"
    ],
    "payoff_formula": {
      "formula": "Payoff = w1*U + w2*R - w3*C - w4*V + w5*Tr + w6*N",
      "variables": {
        "U": "utility",
        "R": "robustness",
        "C": "compute_or_cost",
        "V": "violations",
        "Tr": "transfer_score",
        "N": "novelty_guard"
      }
    },
    "rating_update": {
      "elo_formula": "Elo' = Elo + K * (Result - Expected)"
    },
    "gt_ttl": {
      "half_life_formula": "half_life = base * sigmoid((Elo - mu) / s) * (1 - normalized_regret) * freshness_boost",
      "decay_rate_formula": "decay_rate = ln(2) / half_life"
    },
    "required_output_fields": [
      "gt_report_id",
      "game_mode",
      "winner",
      "mix",
      "ratings",
      "regret",
      "half_life_hours",
      "decision",
      "audit"
    ],
    "early_stop_allowed": true,
    "early_stop_methods": [
      "successive_halving",
      "sprt",
      "bayesian_early_stopping",
      "top_two_thompson_sampling"
    ]
  },

  "marenna": {
    "id": "module_marenna",
    "name": "Marennya",
    "type": "intradomain_reflection",
    "triggers": [
      "after_task",
      "idle_tick",
      "event_driven",
      "staleness_driven"
    ],
    "input_sources": [
      "work_records",
      "deadends",
      "gt_reports",
      "viability_feedback",
      "recent_traces"
    ],
    "output_types": [
      "marenna_reflection",
      "marenna_patch",
      "validator_patch",
