efore==(Path(folder)/'disposable_batch.json').read_bytes()", "    return dict(status='PASS_SAVED_MOCK_RECONCILIATION',new_dispatch=0,receipt_id=value['receipt']['artifact_id'],", "        limitation='Saved exact local mock state and receipt only; not adversarial storage authentication or power-loss recovery')", "if __name__=='__main__':", "    import sys", "    print(json.dumps(verify_example(sys.argv[1]),sort_keys=True))"], "path": "example/reconcile_receipt.py", "sha256": "5947f72264495274b991ee8eb244372e47892c8ee522560cc8c10de327d24b95", "start_line": 1, "total_lines": 30}, "status": "COMMITTED"}
