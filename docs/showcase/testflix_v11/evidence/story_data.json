    {
      "id": "P01",
      "title": "Choose and start",
      "summary": "AD_FREE with a EUR 6.50 ceiling selects the EUR 5.00, 720p, ad-free plan. Four Root decisions precede mock payment, entitlement, session and playback.",
      "execution": "V09_LIVE_MAIN",
      "evidence_ids": [
        "main_result",
        "main_history"
      ]
    },
    {
      "id": "P02",
      "title": "Ask without buying again",
      "summary": "An informational request reuses admissible stored results. It adds no model call or business effect.",
      "execution": "V09_LIVE_MAIN",
      "evidence_ids": [
        "main_result",
        "main_history"
      ]
    },
    {
      "id": "P03",
      "title": "Stop. Start a fresh session.",
      "summary": "The same four Hosts retain their histories. A fresh session and device authority permit playback without another payment.",
      "execution": "V09_LIVE_MAIN",
      "evidence_ids": [
        "main_result",
        "main_history"
      ]
    },
    {
      "id": "P04",
      "title": "The price changes",
      "summary": "A pending EUR 5.00 packet cannot execute against changed terms. Public E recomputes the affected branch. EUR 7.00 exceeds EUR 6.50 consent; an independent EUR 6.00 control passes. The paid period remains preserved.",
      "execution": "V09_SEPARATE_CONTROLLED_PUBLIC_E",
      "evidence_ids": [
        "p04_700_extract",
        "n14_600_extract",
        "n14_600_payment",
        "supplied_1_d",
        "supplied_1_e",
        "supplied_2_d",
        "supplied_2_e"
      ]
    },
    {
      "id": "P05",
      "title": "Expiry means expiry",
      "summary": "At and after the exact entitlement boundary, the old right cannot authorize a new start. Historical records remain replayable.",
      "execution": "V09_LIVE_MAIN_AND_CONTROLLED_BOUNDARY",
      "evidence_ids": [
        "p05_boundary",
        "p05_after",
        "main_replay"
      ]
    },
    {
      "id": "P06",
      "title": "Renew with new consent",
      "summary": "An explicit EUR 7.00 consent permits a new payment and paid period. Stop and fresh-session actions still reuse the same four Hosts. Main history finishes with exactly two payments.",
      "execution": "V09_LIVE_MAIN",
      "evidence_ids": [
        "main_result",
        "post_renewal_result",
        "main_history"
      ]
    }
