{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgehog-os.local/schemas/drs_record.schema.json",
  "title": "Local DRS Record",
  "type": "object",
  "required": [
    "record_id",
    "layer",
    "type",
    "domain",
    "content",
    "time_envelope",
    "provenance",
    "status"
  ],
  "properties": {
    "record_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "layer": {
      "enum": [
        "work",
        "thoughts",
        "up",
        "quarantine",
        "deadends"
      ]
    },
    "type": {
      "enum": [
        "task_outcome",
        "profile",
        "identity_pointer",
        "document_pointer",
        "reflection",
        "protocol_patch",
        "validator_patch",
        "dead_end",
        "opportunity",
        "protocol_template",
        "trace_summary",
        "generic"
      ]
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/Domain"
    },
    "content": {
      "type": "object"
    },
    "pointer": {
      "type": "object",
      "required": [
        "storage_kind",
        "ref"
      ],
      "properties": {
        "storage_kind": {
          "enum": [
            "inline",
            "local_json",
            "local_secure_vault",
            "local_memory",
            "vector_store",
            "document_store",
            "project_store",
            "external_drs_pointer"
          ]
        },
        "ref": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "access_policy": {
          "type": "object",
          "required": [],
          "properties": {
            "visibility": {
              "enum": [
                "private",
                "team",
                "project",
                "public"
              ]
            },
            "requires_user_confirmation": {
              "type": "boolean"
            },
            "read_summary_only": {
              "type": "boolean"
            },
            "read_payload_allowed": {
              "type": "boolean"
            },
            "write_allowed": {
              "type": "boolean"
            },
            "allowed_use": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/NonEmptyString"
              }
            },
            "forbidden_use": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/NonEmptyString"
              }
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        },
        "hash": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "time_envelope": {
      "$ref": "time_envelope.schema.json"
    },
    "provenance": {
      "type": "object",
      "required": [
        "request_id",
        "created_by",
        "trace_refs"
      ],
      "properties": {
        "request_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "created_by": {
          "enum": [
            "root_orchestrator",
            "marenna",
            "up",
            "gt_validator",
            "post_vv",
            "executor"
          ]
        },
        "trace_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/TraceRef"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "accepted",
        "rejected",
        "quarantined",
        "archived",
        "no_update"
      ]
    },
    "gt": {
      "type": "object",
      "required": [],
      "properties": {
        "gt_report_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "elo": {
          "type": "number"
        },
        "regret": {
          "type": "number",
          "minimum": 0
        },
        "half_life_hours": {
          "type": "number",
          "minimum": 0
        },
        "decay_rate": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "viability_feedback": {
      "type": "object",
      "required": [],
      "properties": {
        "vector_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "predicted": {
          "$ref": "common.schema.json#/$defs/Score01"
        },
        "actual": {
          "$ref": "common.schema.json#/$defs/Score01"
        },
        "delta": {
          "type": "number"
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [],
      "properties": {
        "vv_report_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "validated_at": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "revise",
            "no_update"
          ]
        }
      },
      "additionalProperties": false
    },
    "hash": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "previous_hash": {
      "$ref": "common.schema.json#/$defs/NonEmptyString"
    },
    "trace_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/TraceRef"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ProvenanceRef"
      }
    }
  },
  "additionalProperties": false
}
