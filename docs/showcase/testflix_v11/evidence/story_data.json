  "acceptance_scope": "SCOPED_TESTFLIX_IMPLEMENTATION_ACCEPTED_AFTER_OWNER_EXECUTION",
  "one_sentence": "Real Gemini outputs drive a subscription choice; four independent Roots govern mock payment, entitlement and playback while current facts, consent and history stay distinct.",
  "currency": {
    "code": "EUR",
    "integer_unit": "minor currency units",
    "display_conversion": "100 minor units = EUR 1.00"
  },
  "roles": [
    {
      "id": "intent_interpreter",
      "title": "Interpret intent",
      "responsibility": "Express the supplied preference and priorities; identify missing required evidence.",
      "cannot": "Create payment authority."
    },
    {
      "id": "provider_terms_analyst",
      "title": "Read the terms",
      "responsibility": "Project each supplied plan and determine eligibility against the explicit price ceiling.",
      "cannot": "Change catalogue facts or the budget."
    },
    {
      "id": "client_plan_selector",
      "title": "Propose a plan",
      "responsibility": "Consume intent and terms, select an eligible plan and explain its trade-offs.",
      "cannot": "Execute its own proposal."
    },
    {
      "id": "contract_reviewer",
      "title": "Challenge the proposal",
      "responsibility": "Check the selection against the same request and upstream evidence; disclose blocking conflicts.",
      "cannot": "Override an independent Root decision."
    }
  ],
  "roots": [
    {
      "id": "root:testflix:user",
      "name": "UserRoot",
      "decision": "Accept the purchase selection for the user."
    },
    {
      "id": "root:testflix:bank",
      "name": "BankRoot",
      "decision": "Review the payment action against current terms and consent."
    },
    {
      "id": "root:testflix:provider",
      "name": "ProviderRoot",
      "decision": "Authorize entitlement issuance using the payment receipt."
    },
    {
      "id": "root:testflix:device",
      "name": "DeviceRoot",
      "decision": "Authorize playback within the current session and device grant."
    }
  ],
