    "ownership": "Local resource ownership, not shared business supremacy",
    "permission": "Scoped required authorization; no implication of transferable permission",
    "authorized_execution": "Current admitted operation through the existing authority path",
    "provenance": "Binds historical result/evidence",
    "documentary_reference": "Explanation/comparison only, never runtime dataflow or causal continuity"
