{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football.request.v01",
  "description": "Static closed shape; candidate_domain relational validators additionally enforce identities, uniqueness, consent, calendar intervals and arithmetic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "revision",
    "operation",
    "team_ref",
    "venue_ref",
    "timezone",
    "currency",
    "budget_minor",
    "owner_approval_ref",
    "sessions"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4611686018427388000
    },
    "operation": {
      "enum": [
        "FIND_OFFER",
        "CONFIRM_MOCK_BOOKING",
        "VERIFY_EXISTING",
        "CLARIFY"
      ]
    },
    "team_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "venue_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "timezone": {
      "const": "Europe/Tirane"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "budget_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4611686018427388000
    },
    "owner_approval_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "start",
          "end",
          "allow_shift_minutes"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "start": {
            "type": "string",
            "pattern": "^2027-01-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
          },
          "end": {
            "type": "string",
            "pattern": "^2027-01-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
          },
          "allow_shift_minutes": {
            "enum": [
              0,
              30
            ]
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
