    check_report(case,report)
    if case['request']['operation']=='FIND_OFFER' and (report['status']=='OFFER_READY' or 'venue_work' in proofs):
        context=expected_context(case,proofs);requester=proofs['requester_work'];body=context['body']
        result=native_result(requester,'ActivePlanetRoot',dict(request_json=canonical(case['request']).decode(),offer_json=canonical(context).decode()))
        semantic={k:v for k,v in report.items() if k!='native_refs'}
