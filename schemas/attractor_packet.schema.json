{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgehog-os.local/schemas/attractor_packet.schema.json",
  "title": "AttractorPacket",
  "type": "object",
  "required": [
    "packet_id",
    "goal",
    "world_state_ref",
    "time_context",
    "hard_forbidden_regions",
    "candidate_vectors",
    "branch_budget",
    "exploration_budget",
    "architect_instructions"
  ],
  "properties": {
    "packet_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "goal": {
      "type": "object",
      "required": [
        "goal_id",
        "desired_state"
      ],
      "properties": {
        "goal_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "desired_state": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "world_state_ref": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "time_context": {
      "type": "object",
      "required": [
        "as_of",
        "freshness_required"
      ],
      "properties": {
        "as_of": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "freshness_required": {
          "enum": [
            "low",
            "normal",
            "high",
            "real_time"
          ]
        },
        "timezone": {
          "$ref": "common.schema.json#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "hard_forbidden_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "region_id",
          "reason"
        ],
        "properties": {
          "region_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "reason": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          },
          "policy_ref": {
            "$ref": "common.schema.json#/$defs/PolicyRef"
          }
        },
        "additionalProperties": false
      }
    },
    "candidate_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "vector_id",
          "source",
          "domain",
          "final_viability",
          "hard_masked",
          "soft_mask",
          "branching_mode",
          "branch_budget"
        ],
        "properties": {
          "vector_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "source": {
            "enum": [
              "needle",
              "local_drs",
              "external_drs_pointer",
              "fallback_template"
            ]
          },
          "domain": {
            "$ref": "common.schema.json#/$defs/Domain"
          },
          "final_viability": {
            "$ref": "common.schema.json#/$defs/Score01"
          },
          "hard_masked": {
            "type": "boolean"
          },
          "soft_mask": {
            "$ref": "common.schema.json#/$defs/Score01"
          },
          "branching_mode": {
            "enum": [
              "horizontal",
              "vertical",
              "hybrid",
              "fallback"
            ]
          },
          "branch_budget": {
            "type": "object",
            "required": [
              "max_fractals",
              "max_depth",
              "parallelism"
            ],
            "properties": {
              "max_fractals": {
                "type": "integer",
                "minimum": 0
              },
              "max_depth": {
                "type": "integer",
                "minimum": 0
              },
              "parallelism": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "selection_status": {
            "enum": [
              "selected",
              "masked",
              "deferred"
            ]
          },
          "mask_reason": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          }
        },
        "additionalProperties": false
      }
    },
    "branch_budget": {
      "type": "object",
      "required": [
        "max_fractals",
        "max_depth",
        "parallelism"
      ],
      "properties": {
        "max_fractals": {
          "type": "integer",
          "minimum": 0
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "exploration_budget": {
      "type": "object",
      "required": [
        "max_exploration_vectors",
        "exploration_allowed"
      ],
      "properties": {
        "max_exploration_vectors": {
          "type": "integer",
          "minimum": 0
        },
        "exploration_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "architect_instructions": {
      "type": "object",
      "required": [
        "do_not_expand_forbidden_regions",
        "must_return_time_assumptions",
        "must_return_result_proposals_only"
      ],
      "properties": {
        "do_not_expand_forbidden_regions": {
          "const": true
        },
        "must_return_time_assumptions": {
          "const": true
        },
        "must_return_result_proposals_only": {
          "const": true
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NonEmptyString"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
