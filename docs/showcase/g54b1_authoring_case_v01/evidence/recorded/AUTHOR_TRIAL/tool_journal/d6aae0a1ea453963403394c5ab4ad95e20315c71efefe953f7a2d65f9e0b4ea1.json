{"call": {"arguments": {"max_lines": 220, "path": "example/mock_effect.py"}, "callId": "exec-176954c3-1172-4ca5-8184-b023a415120d", "namespace": null, "threadId": "01a0d772-efdf-72b2-8663-0cda590c35f4", "tool": "read_approved_source", "turnId": "01a0d772-effe-7de2-9110-f48481b18b1c"}, "response": {"lines": ["\"\"\"One finite two-record disposable MOCK snapshot, through public Host/Firewall only.\"\"\"", "import json", "import os", "from pathlib import Path", "from native_seams import action, firewall, hosts, mocks, donor, canonical, digest, save, plain", "", "STATE_PATH = None", "PACKET_KEYS = {}", "EXECUTIONS = []", "", "", "def execute_batch_v01(invocation):", "    values={v.parameter_name:v.value for v in invocation.inputs}", "    assert invocation.packet_id in PACKET_KEYS and STATE_PATH is not None", "    key=PACKET_KEYS[invocation.packet_id]", "    fingerprint=digest(values)", "    old=json.loads(STATE_PATH.read_text()) if STATE_PATH.exists() else dict(records={},idempotency={})", "    if key in old['idempotency']:", "        if old['idempotency'][key]['payload_sha256'] != fingerprint:", "            raise ValueError('g50_same_key_changed_payload')", "        outcome=old['idempotency'][key]['output']", "    else:", "        outcome=dict(device_ref=values['device_ref'],enabled=values['enabled'],batch_state='COMMITTED_TWO_RECORDS')", "        new=dict(records=dict(old['records']),idempotency=dict(old['idempotency']))", "        for name in ('record:alpha','record:beta'):", "            new['records'][name]=dict(enabled=values['enabled'],owner=invocation.owning_root_id)", "        new['idempotency'][key]=dict(payload_sha256=fingerprint,output=outcome,packet_id=invocation.packet_id)", "        # One atomic replacement owns both records and the idempotency entry. No external effect.", "        temporary=STATE_PATH.with_suffix('.pending')", "        with temporary.open('wb') as stream:", "            stream.write(canonical(new));stream.flush();os.fsync(stream.fileno())", "        os.replace(temporary,STATE_PATH)", "        EXECUTIONS.append(dict(invocation_id=invocation.invocation_id,key=key,payload_sha256=fingerprint))", "    return tuple(action.build_action_effect_parameter_record_v01(parameter_name=n,value_type=t,value=outcome[n])", "        for n,t in (('batch_state','TEXT'),('device_ref','REFERENCE'),('enabled','BOOLEAN')))", "", "", "def validate_batch_output_v01(definition, invocation, output):", "    errors=firewall.validate_capability_values_v01(definition.output_fields,output)", "    values={v.parameter_name:v.value for v in invocation.inputs}", "    if not errors and {v.parameter_name:v.value for v in output} != dict(values,batch_state='COMMITTED_TWO_RECORDS'):", "        errors=('g50_batch_result_mismatch',)", "    return firewall.build_capability_validation_evidence_v01(definition=definition,values=output,", "        invocation_id=invocation.invocation_id,valid=not errors,reason_codes=errors)", "", "", "def admit_v01():", "    device='device:g50:disposable'", "    functions=(mocks.validate_work_inputs_v01,validate_batch_output_v01,execute_batch_v01)", "    code=tuple(hosts.observe_local_capability_code_v01(f) for f in functions)", "    semantics=firewall.build_capability_business_semantics_v01(operation_key='g50.batch.v01',selected_action_class='mock_action:batch',", "        logical_effect_class='BATCH',logical_effect_namespace='g50.batch.v01',business_object_class='RECORD_SET',", "        business_object_namespace='g50.records.v01',input_bindings=(", "            firewall.build_capability_business_input_binding_v01(input_name='device_ref',source_kind='TARGET_RECORD',source_name='device_ref',value_type='REFERENCE'),", "            firewall.build_capability_business_input_binding_v01(input_name='enabled',source_kind='RECORD',source_name='enabled',value_type='BOOLEAN')))", "    definition=firewall.build_capability_definition_v01(operation_id=semantics.operation_key,version='v01',effect_kind='MOCK_CONSEQUENTIAL',", "        business_semantics=semantics,input_fields=tuple(firewall.build_capability_field_v01(name=n,value_type=t,required=True,consequential=True)", "            for n,t in (('device_ref','REFERENCE'),('enabled','BOOLEAN'))),", "        output_fields=tuple(firewall.build_capability_field_v01(name=n,value_type=t,required=True,consequential=False)", "            for n,t in (('device_ref','REFERENCE'),('enabled','BOOLEAN'),('batch_state','TEXT'))),resource_refs=(device,),", "        input_validator_ref=code[0].public_symbol,output_validator_ref=code[1].public_symbol,executor_ref=code[2].public_symbol,", "        code_sha256s=tuple((s.public_symbol,s.source_sha256) for s in code))", "    return hosts.admit_local_capability_v01(definition=definition,input_validator=functions[0],output_validator=functions[1],", "        executor=functions[2],catalogue_revision=0,host_instance_ref='host:g50:effect')"], "path": "example/mock_effect.py", "sha256": "77ca3e483d52d3344fc7fd09dd7880fe29440c40cb79a8ee798acec242a1fce7", "start_line": 1, "total_lines": 64}, "status": "COMMITTED"}
