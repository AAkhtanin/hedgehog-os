        "write JSON schemas",
        "write schema validation helper",
        "write initial invariant tests"
      ]
    },
    {
      "phase": 2,
      "name": "Local DRS",
      "tasks": [
        "implement JSON file store",
        "implement write/read by layer",
        "implement TemporalQuery filter",
        "implement dead-end retrieval"
      ]
    },
    {
      "phase": 3,
      "name": "CandidateVector and AVF",
      "tasks": [
        "load needles",
        "generate candidate vectors",
        "apply hard masks",
        "compute vectorized scores",
        "select Top-K",
        "produce AttractorPacket"
      ]
    },
    {
      "phase": 4,
      "name": "Architect and Executors",
      "tasks": [
        "implement deterministic Architect stub",
        "implement simulated Executors",
        "return ResultProposals"
      ]
    },
    {
      "phase": 5,
      "name": "Post V&V and GT",
      "tasks": [
        "validate proposals",
        "normalize features",
        "compute payoff",
        "update Elo",
        "compute half-life",
        "produce GTReport"
      ]
    },
    {
      "phase": 6,
      "name": "RootOrchestrator",
      "tasks": [
        "wire full pipeline",
        "enforce root-only FinalOutput",
        "write DRS records",
        "emit trace"
      ]
    },
    {
      "phase": 7,
      "name": "Marennya and UP hooks",
      "tasks": [
        "implement after_task hooks",
        "write quarantine records",
        "stub six-stage validation",
        "allow promotion after validation"
      ]
    },
    {
      "phase": 8,
      "name": "Demo runner",
      "tasks": [
        "create cold_start scenario",
        "create reuse scenario",
        "show DRS before/after",
        "print AVF decisions and GT updates"
      ]
    }
  ],

