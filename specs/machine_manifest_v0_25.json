  "tests": {
    "required_invariant_tests": [
      {
        "id": "test_final_output_root_only",
        "statement": "Only RootOrchestrator may create FinalOutput."
      },
      {
        "id": "test_executor_no_final_output",
        "statement": "Executor output must validate as ResultProposal and must not include final_output."
      },
      {
        "id": "test_time_envelope_required",
        "statement": "Every DRSRecord must include TimeEnvelope."
      },
      {
        "id": "test_temporal_query_required",
        "statement": "DRS retrieval requires TemporalQuery."
      },
      {
        "id": "test_avf_hardmask",
        "statement": "Forbidden vectors must be removed before AttractorPacket reaches Architect."
      },
      {
        "id": "test_candidate_vectors_no_llm_hallucination",
        "statement": "CandidateVectors must come from needles, DRS, external pointers or fallback templates."
      },
      {
        "id": "test_gt_updates_half_life",
        "statement": "GTValidator must update half_life_hours or explicitly return no_update."
      },
      {
        "id": "test_marenna_quarantine",
        "statement": "Marennya writes to quarantine before Thoughts."
      },
      {
        "id": "test_up_never_mutates_work",
        "statement": "UP cannot mutate Work directly."
      },
      {
        "id": "test_work_thoughts_up_separation",
        "statement": "Work, Thoughts and UP records must remain layer-separated."
      }
    ]
  },

