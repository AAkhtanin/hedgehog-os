{
  "title": "Testflix",
  "subtitle": "From model reasoning to a governed subscription lifecycle.",
  "version": "V11",
  "accepted_on": "2026-09-13",
  "accepted_commit": "e42d37fa98dfec7110b8cf75b1aceaa614f461be",
  "accepted_parent": "54e32dbcc0e4d68431ec2b9428eac965f88ee47c",
