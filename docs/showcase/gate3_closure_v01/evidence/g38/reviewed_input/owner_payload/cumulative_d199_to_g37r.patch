+@pytest.mark.parametrize('field,value', [('transaction_id','wrong:transaction'),('local_root_scope_id','root:foreign'),
+    ('source_profile_id','unknown.source'),('scenario_id','changed.label'),('source_closure_ref','wrong:closure'),
