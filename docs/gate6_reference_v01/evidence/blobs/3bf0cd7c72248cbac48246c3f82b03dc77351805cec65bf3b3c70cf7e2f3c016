ints),\n        selection=feedback.g35_record_to_plain_v01(selection))\n\n\ndef evaluate_v01(material, *, provenance=False):\n    require(set(material) == {'checks', 'constraints', 'selection'} and len(material['checks']) == 1, 'atlas_airline_material')\n    check = material['checks'][0]\n    constraints = feedback.g35_record_from_plain_v01(material['constraints'])\n    snapshot = feedback.g35_record_from_plain_v01(check['observations'][0]['snapshot'])\n    selection = binding.build_selection_input_v01(binding.build_valid_airline_bsep_projection_ref_v01(), constraints, snapshot)\n    require(feedback.g35_record_to_plain_v01(selection) == material['selection'], 'atlas_airline_selection_material')\n    require(check['observations'][0]['observation_id'] == 'airline:snapshot:' + snapshot.candidate_set_digest, 'atlas_airline_observation')\n    healthy = check['offer_id'] in selection.client_hard_compatible_candidate_ids\n    # Both strategies retain hard constraints. The second additionally consumes\n    # the accepted public source/snapshot validation rather than a learned grant.\n    reports = []\n    if provenance:\n        reports = [binding.validate_airline_candidate_snapshot_v01(snapshot),\n                   binding.validate_client_root_travel_constraint_set_v01(constraints)]\n        require(all(r.validation_status == 'PASS' for r in reports), 'atlas_airline_provenance')\n    return dict(stage='RESULT', checks=[dict(healthy=healthy, semantic_ref=check['semantic_ref'])],\n        semantic_refs=[check['semantic_ref']], input_sha256=digest(material), offer_id=check['offer_id'],\n        provenance_checked=provenance, source_validation=feedback.g35_record_to_plain_v01(tuple(reports)))\n\n\ndef input_validator_v01(definition, inputs):\n    errors = fw.validate_capability_values_v01(definition.input_fields, inputs)\n    if not errors:\n        try:\n            evaluate_v01(json.loads(values(inputs)['material']))\n        except (ValueError, TypeError, KeyError):\n            errors = ('atlas_airline_input',)\n    return fw.build_capability_validation_evidence_v01(definition=definition, values=inputs, invocation_id=None, valid=not errors, reason_codes=errors)\n\n\ndef execute_constraint_v01(invocation):\n    output = evaluate_v01(json.loads(values(invocation.inputs)['material']))\n    return (actions.ActionEffectParameterRecordV01('material', 'TEXT', canonical(output).decode()),)\n\n\ndef execute_provenance_v01(invocation):\n    output = evaluate_v01(json.loads(values(invocation.inputs)['material']), provenance=True)\n    return (actions.ActionEffectParameterRecordV01('material', 'TEXT', canonical(output).decode()),)\n\n\ndef output_validator_v01(definition, invocation, output):\n    errors = fw.validate_capability_values_v01(definition.output_fields, output)\n    if not errors:\n        expected = evaluate_v01(json.loads(values(invocation.inputs)['material']), provenance=definition.operation_id == 'atlas.airline.provenance')\n        if json.loads(values(output)['material']) != expected:\n            errors += ('atlas_airline_output',)\n    return fw.build_capability_validation_evidence_v01(definition=definition, values=output, invocation_id=invocation.invocation_id, valid=not errors, reason_codes=errors)\n\n\ndef catalogue_v01():\n    result = []\n    for name, executor in (('constraint', execute_constraint_v01), ('provenance', execute_provenance_v01)):\n        functions = (input_validator_v01, output_validator_v01, executor)\n        codes = tuple(hosts.observe_local_capability_code_v01(f) for f in functions)\n        definition = fw.build_capability_definition_v01(operation_id='atlas.airline.' + name, version='v01', effect_kind='PURE', business_semantics=None,\n            input_fields=(fw.build_capability_field_v01(name='material', value_type='TEXT', required=True, consequential=False),),\n            output_fields=(fw.build_capability_field_v01(name='material', value_type='TEXT', required=True, consequential=False),), reso