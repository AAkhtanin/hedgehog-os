{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:football:FootballVenueOfferV01",
  "title": "FootballVenueOfferV01",
  "description": "Closed shape only. profile.py additionally checks native time identity, bounded integers, request bindings, slot equations and meaning. Cryptographic/current-use predicates remain in the public contract validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_record_ref",
    "source_revision",
    "source_work_ref",
    "source_review_ref",
    "time_envelope",
    "ttl_base",
    "source_lineage_refs",
    "publisher",
    "recipient",
    "request_sha256",
    "offer",
    "booking"
  ],
  "properties": {
    "version": {
      "const": "g51.body.v01"
    },
    "source_record_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_work_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
    },
    "source_review_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
    },
    "time_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_envelope_version",
        "time_envelope_id",
        "pt_created_at",
        "kt_as_of",
        "et_observed_at",
        "ct_context_anchor",
        "ttl_seconds",
        "valid_from",
        "valid_to",
        "source_observed_at",
        "source_reported_at",
        "system_ingested_at",
        "system_verified_at",
        "freshness_policy_id"
      ],
      "properties": {
        "time_envelope_version": {
          "type": "string"
        },
        "time_envelope_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
        },
        "pt_created_at": {
          "type": "integer",
          "minimum": 0
        },
        "kt_as_of": {
          "type": "integer",
          "minimum": 0
        },
        "et_observed_at": {
          "type": "integer",
          "minimum": 0
        },
        "ct_context_anchor": {
          "type": "integer",
          "minimum": 0
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "valid_from": {
          "type": "integer",
          "minimum": 0
        },
        "valid_to": {
          "type": "integer",
          "minimum": 0
        },
        "source_observed_at": {
          "type": "integer",
          "minimum": 0
        },
        "source_reported_at": {
          "type": "integer",
          "minimum": 0
        },
        "system_ingested_at": {
          "type": "integer",
          "minimum": 0
        },
        "system_verified_at": {
          "type": "integer",
          "minimum": 0
        },
        "freshness_policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
        }
      }
    },
    "ttl_base": {
      "const": "pt_created_at"
    },
    "source_lineage_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "publisher": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "offer": {
      "$ref": "#/$defs/offer"
    },
    "booking": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "receipt_ref",
            "payload_sha256",
            "snapshot_sha256",
            "packet_ref",
            "slots",
            "request_sha256"
          ],
          "properties": {
            "state": {
              "const": "COMMITTED"
            },
            "receipt_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "snapshot_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "packet_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
            },
            "slots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/slot"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "request_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "revision",
        "operation",
        "team_ref",
        "venue_ref",
        "timezone",
        "currency",
        "budget_minor",
        "owner_approval_ref",
        "sessions"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "FIND_OFFER",
            "CONFIRM_MOCK_BOOKING",
            "VERIFY_EXISTING",
            "CLARIFY"
          ]
        },
        "team_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "venue_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "timezone": {
          "const": "Europe/Tirane"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "budget_minor": {
          "type": "integer",
          "minimum": 0
        },
        "owner_approval_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "start",
              "end",
              "allow_shift_minutes"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
              },
              "start": {
                "type": "string",
                "pattern": "^2027-01-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
              },
              "end": {
                "type": "string",
                "pattern": "^2027-01-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$"
              },
              "allow_shift_minutes": {
                "enum": [
                  0,
                  30
                ]
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "venue_ref",
        "field_id",
        "start_utc",
        "end_utc",
        "price_minor"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "venue_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "field_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
        },
        "start_utc": {
          "type": "integer",
          "minimum": 0
        },
        "end_utc": {
          "type": "integer",
          "minimum": 0
        },
        "price_minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "schedule_revision",
        "offer_revision",
        "status",
        "fields",
        "alternatives",
        "slots",
        "total_minor",
        "currency"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "schedule_revision": {
          "type": "integer",
          "minimum": 1
        },
        "offer_revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "OFFER_READY",
            "NO_COMPLETE_OFFER",
            "NEEDS_CONFIRMATION"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field_id",
              "surface",
              "full_size",
              "price_minor"
            ],
            "properties": {
              "field_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
              },
              "surface": {
                "const": "NATURAL_GRASS"
              },
              "full_size": {
                "const": true
              },
              "price_minor": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "minItems": 0,
          "maxItems": 4
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "choices"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
              },
              "choices": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/slot"
                },
                "minItems": 1,
                "maxItems": 2
              }
            }
          },
          "minItems": 0,
          "maxItems": 3
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          },
          "minItems": 0,
          "maxItems": 3
        },
        "total_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
